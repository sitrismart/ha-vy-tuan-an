# VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY: Supabase project credentials
# used to store RSVP submissions and the live guestbook wall.
# Get these from your Supabase project's Settings > API page.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# VITE_ADMIN_PASSWORD: simple password gate for the /admin page.
# Not real security (it ships inside the client bundle) — only a soft deterrent
# alongside keeping the /admin URL unlisted.
VITE_ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"